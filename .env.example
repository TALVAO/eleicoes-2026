# Local development: worker and Next.js share this directory.
CACHE_DIR=.data
# Production: both worker and Vercel use the same Redis, TLS recommended.
# REDIS_URL=rediss://...
TSE_ELECTION_DATE=04/10/2026
TSE_TURN=1
TSE_REQUESTS_PER_SECOND=4
TSE_TIMEOUT_MS=8000
TSE_MAX_BYTES=20971520
# HTTPS public URL for metadata.
SITE_URL=http://localhost:3000
# Only for tunnels/hosting that do not support SSE; client uses the internal API every 15s.
# LIVE_TRANSPORT=polling
# Free gateway only: matching private secrets in local Next.js and Vercel gateway.
# FREE_GATEWAY_TOKEN=... (local Next.js only; scripts use .local/free/gateway-token.txt)
# GATEWAY_TOKEN=... (Vercel gateway only, same secret)
# GATEWAY_ORIGIN=https://your-tunnel.loca.lt (Vercel gateway only)
# Visitor chat requires shared Redis; defaults to REDIS_URL.
# CHAT_REDIS_URL=redis://127.0.0.1:6386/0
# Server-only moderator secret, at least 32 characters. Never use NEXT_PUBLIC_.
# CHAT_ADMIN_TOKEN=... (free scripts use .local/free/chat-admin-token.txt)
# Isolated validation only, never production DB 0:
# CHAT_TEST_REDIS_URL=redis://127.0.0.1:6386/15
