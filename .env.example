# Local development: worker and Next.js share this directory.
CACHE_DIR=.data
# Production: both worker and Vercel use the same Redis, TLS recommended.
# REDIS_URL=rediss://...
TSE_ELECTION_DATE=04/10/2026
TSE_TURN=1
TSE_REQUESTS_PER_SECOND=4
TSE_TIMEOUT_MS=8000
TSE_MAX_BYTES=20971520
# HTTPS public URL for metadata.
SITE_URL=http://localhost:3000
# Only for tunnels/hosting that do not support SSE; client uses the internal API every 15s.
# LIVE_TRANSPORT=polling
